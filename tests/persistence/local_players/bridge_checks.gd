# Original MIT. Focused SAME-boundary ClassDB tests, not the full player journey.
# Root supplies an isolated resource/project and the four pinned user-argv pairs.
extends RefCounted

var _checks: int = 0
var _failures: Array[String] = []
# Only populated on failed actual join; keeps the test instance alive.
var _retained: Object

func _check(ok: bool, label: String) -> void:
	_checks += 1
	if not ok:
		_failures.append(label)

func _closed(value: Variant, keys: Array[String]) -> bool:
	if typeof(value) != TYPE_DICTIONARY or value.size() != keys.size():
		return false
	for key: Variant in value:
		if typeof(key) != TYPE_STRING or not keys.has(key):
			return false
	return true

func _admission(value: Variant, accepted: bool, error: String) -> bool:
	if not _closed(value, ["accepted", "error_code", "request_id"]):
		return false
	if typeof(value.accepted) != TYPE_BOOL or value.accepted != accepted or typeof(value.error_code) != TYPE_STRING or value.error_code != error:
		return false
	return _hex(value.request_id, 32) if accepted else value.request_id == null

func _hex(value: Variant, length: int) -> bool:
	if typeof(value) != TYPE_STRING or value.length() != length:
		return false
	for i: int in range(length):
		var c: int = value.unicode_at(i)
		if not ((c >= 48 and c <= 57) or (c >= 97 and c <= 102)):
			return false
	return true

func _u64(value: Variant, positive: bool = false) -> bool:
	if typeof(value) != TYPE_STRING or value.is_empty() or value.length() > 20:
		return false
	if value.length() > 1 and value[0] == "0":
		return false
	for i: int in range(value.length()):
		var c: int = value.unicode_at(i)
		if c < 48 or c > 57:
			return false
	return (not positive or value != "0") and (value.length() < 20 or value <= "18446744073709551615")

func _status(value: Variant) -> bool:
	if not _closed(value, ["state", "error_code", "pending", "undelivered", "writer_alive", "resolved_root", "store_version"]):
		return false
	return typeof(value.state) == TYPE_STRING and value.state in ["new", "opening", "ready", "closing", "closed", "read_only", "unavailable"] and typeof(value.error_code) == TYPE_STRING and typeof(value.pending) == TYPE_INT and typeof(value.undelivered) == TYPE_INT and value.pending >= 0 and value.undelivered >= 0 and value.pending + value.undelivered <= 16 and typeof(value.writer_alive) == TYPE_BOOL and (value.resolved_root == null or typeof(value.resolved_root) == TYPE_STRING) and (value.store_version == null or (typeof(value.store_version) == TYPE_INT and value.store_version == 1))

func _descriptor() -> Variant:
	var args: PackedStringArray = OS.get_cmdline_user_args()
	var path: String = ""
	for i: int in range(0, args.size(), 2):
		if args[i] == "--local-players-test-descriptor" and i + 1 < args.size():
			path = args[i + 1]
	if path.is_empty():
		return null
	# All nine descriptor values are actual Strings; no decimal-number parse is
	# trusted here. Native reads/hash-checks the independently bound RAW file.
	var file: FileAccess = FileAccess.open(path, FileAccess.READ)
	if file == null or file.get_length() < 1 or file.get_length() > 16384:
		return null
	var raw: PackedByteArray = file.get_buffer(file.get_length())
	file.close()
	return JSON.parse_string(raw.get_string_from_utf8())

func _same_bits(a: Variant, b: Variant) -> bool:
	return typeof(a) == typeof(b) and var_to_bytes(a) == var_to_bytes(b)

func _foreign_calls(object: Object, descriptor: Dictionary) -> Dictionary:
	# Real foreign native entry calls. No SQLite or Variant is handed to a core
	# worker; boundary owner rejection happens before capture/queue/root effects.
	return {"configure": object.call("configure_test_root", descriptor), "start": object.call("start"), "submit": object.call("submit", {"kind": "list_players", "payload": {}}), "status": object.call("status"), "poll": object.call("poll", 1), "shutdown": object.call("begin_shutdown"), "join": object.call("try_join")}

func _terminal(host: Node, object: Object, admission: Variant) -> Dictionary:
	if not _admission(admission, true, ""):
		_check(false, "actual admission before terminal")
		return {}
	var deadline: int = Time.get_ticks_msec() + 30000
	while Time.get_ticks_msec() < deadline:
		var values: Variant = object.call("poll", 8)
		if typeof(values) != TYPE_ARRAY:
			_check(false, "actual full-batch conversion returned Array")
			return {}
		if not values.is_empty():
			_check(values.size() == 1, "one actual terminal for this sequential job")
			if values.size() != 1 or not _closed(values[0], ["request_id", "kind", "state", "error_code", "commit_sequence", "value"]):
				_check(false, "closed six-key actual terminal")
				return {}
			var result: Dictionary = values[0]
			_check(typeof(result.request_id) == TYPE_STRING and result.request_id == admission.request_id, "same real request ID")
			_check(typeof(result.kind) == TYPE_STRING and typeof(result.state) == TYPE_STRING and typeof(result.error_code) == TYPE_STRING, "actual terminal String types")
			return result
		await host.get_tree().process_frame
	_check(false, "actual terminal deadline; no manufactured result")
	return {}

func _close(host: Node, object: Object) -> bool:
	_check(object.call("begin_shutdown") == true, "owner begins actual shutdown")
	var deadline: int = Time.get_ticks_msec() + 30000
	while Time.get_ticks_msec() < deadline:
		if object.call("try_join") == true:
			var s: Variant = object.call("status")
			_check(_status(s) and s.state == "closed" and s.writer_alive == false and s.pending == 0, "actual joined/closed status")
			_check(object.call("poll", 8) == [], "closed consumed queue remains empty")
			_check(object.call("try_join") == true, "joined close is idempotent")
			return true
		await host.get_tree().process_frame
	_check(false, "actual join deadline; object/extension must remain owned")
	return false

func run(host: Node) -> Dictionary:
	_checks = 0
	_failures.clear()
	if _retained != null:
		_check(false, "prior failed join remains owned; do not reuse driver")
		return _receipt(false)
	_check(PackedFloat64Array([-0.0]).to_byte_array().hex_encode() == "0000000000000080" and PackedFloat64Array([1.0]).to_byte_array().hex_encode() == "000000000000f03f", "typed binary64 reference literals before native output")
	_check(host != null and host.is_inside_tree(), "actual rooted test host")
	_check(ClassDB.class_exists("LocalPlayersTest"), "actual test ClassDB registration")
	_check(not ClassDB.class_exists("LocalPlayers"), "shipping storage class/resource absent")
	if host == null or not host.is_inside_tree() or not ClassDB.class_exists("LocalPlayersTest"):
		return _receipt(false)
	var descriptor: Variant = _descriptor()
	_check(typeof(descriptor) == TYPE_DICTIONARY, "Root raw descriptor file decodes to Dictionary")
	if typeof(descriptor) != TYPE_DICTIONARY:
		return _receipt(false)
	var object: Object = ClassDB.instantiate("LocalPlayersTest")
	var method_names: Array[String] = []
	for method: Dictionary in ClassDB.class_get_method_list("LocalPlayersTest", true):
		method_names.append(str(method.name))
	method_names.sort()
	_check(method_names == ["begin_shutdown", "configure_test_root", "poll", "start", "start_management", "status", "submit", "try_join"], "exact eight declared methods including test-only configure")
	var initial: Variant = object.call("status")
	_check(_status(initial) and initial.state == "new" and initial.resolved_root == null and initial.writer_alive == false, "empty wrapper has no root or worker")
	_check(_admission(object.call("start"), false, "invalid_state"), "unconfigured start has no production fallback")
	_check(_admission(object.call("start_management"), false, "invalid_state"), "unconfigured management has no production fallback")
	var invalids: Array[Variant] = [null, [], "descriptor", StringName("descriptor"), {}, descriptor.duplicate(true)]
	invalids[5]["unexpected"] = "extra"
	for name: Variant in descriptor:
		var bad_type: Dictionary = descriptor.duplicate(true)
		bad_type[name] = 0
		invalids.append(bad_type)
		var bad_key: Dictionary = descriptor.duplicate(true)
		bad_key.erase(name)
		bad_key[StringName(name)] = descriptor[name]
		invalids.append(bad_key)
	var wrong_identity: Dictionary = descriptor.duplicate(true)
	wrong_identity["root_file_id"] = "00000000000000000000000000000000" if descriptor.root_file_id != "00000000000000000000000000000000" else "11111111111111111111111111111111"
	invalids.append(wrong_identity)
	for invalid: Variant in invalids:
		_check(object.call("configure_test_root", invalid) == false, "reject malformed/foreign descriptor")
		_check(_same_bits(initial, object.call("status")), "rejected descriptor preserves empty boundary")
	var thread: Thread = Thread.new()
	var started: Error = thread.start(_foreign_calls.bind(object, descriptor))
	_check(started == OK, "actual foreign thread starts")
	if started == OK:
		var foreign: Variant = thread.wait_to_finish()
		_check(typeof(foreign) == TYPE_DICTIONARY and foreign.configure == false and _admission(foreign.start, false, "wrong_thread") and _admission(foreign.submit, false, "wrong_thread") and foreign.status == null and foreign.poll == null and foreign.shutdown == false and foreign.join == false, "owner-only native entry rejection")
	_check(_same_bits(initial, object.call("status")), "foreign entry leaves empty state identical")
	var configured: bool = object.call("configure_test_root", descriptor)
	_check(configured, "source/PID/DLL/rawhash-bound actual capability configures")
	if configured:
		_check(object.call("configure_test_root", descriptor.duplicate(true)) == false, "configure exactly once")
		_check(_same_bits(initial, object.call("status")), "configuration itself does not open store or worker")
		var opened: Dictionary = await _terminal(host, object, object.call("start"))
		_check(opened.get("kind") == "start" and opened.get("state") == "committed" and opened.get("commit_sequence") == "1" and opened.get("error_code") == "", "fresh real SQLite start terminal")
		_check(_closed(opened.get("value"), ["store_version", "interrupted_rows", "created"]) and typeof(opened.value.store_version) == TYPE_INT and opened.value.store_version == 1 and typeof(opened.value.interrupted_rows) == TYPE_INT and opened.value.interrupted_rows == 0 and typeof(opened.value.created) == TYPE_BOOL and opened.value.created, "fresh startup closed types")
		var ready: Variant = object.call("status")
		_check(_status(ready) and ready.state == "ready" and ready.resolved_root == descriptor.root and ready.store_version == 1, "real isolated ready root")
		_check(_admission(object.call("start"), false, "invalid_state") and _admission(object.call("start_management"), false, "invalid_state"), "no in-place restart or management switch")
		for invalid: Variant in [null, true, 1.0, -0.0, NAN, "1", StringName("1"), [], {}, 0, 17]:
			_check(object.call("poll", invalid) == null, "poll exact INT1..16; no coercion")
			_check(_same_bits(ready, object.call("status")), "invalid poll drains/changes nothing")
		_check(object.call("poll") == [], "actual default poll=8")
		var rejected_requests: Array[Array] = [[null, "invalid_type"], [[], "invalid_type"], [true, "invalid_type"], [{"kind": StringName("list_players"), "payload": {}}, "invalid_type"], [{"kind": "list_players", "payload": []}, "invalid_type"], [{"kind": "list_players", "payload": {}, "extra": 1}, "invalid_request"], [{"kind": "unknown", "payload": {}}, "invalid_request"], [{"kind": "start", "payload": {}}, "invalid_request"], [{"kind": "list_players", "payload": {"extra": 1}}, "invalid_record"]]
		for pair: Array in rejected_requests:
			var rejection: Variant = object.call("submit", pair[0])
			_check(_admission(rejection, false, pair[1]), "same boundary exact invalid request code/type")
			_check(_same_bits(ready, object.call("status")), "invalid submit preserves authority/state")
		if _status(ready) and ready.state == "ready":
			await _records(host, object)
	var joined: bool = await _close(host, object)
	if joined:
		_check(object.call("configure_test_root", descriptor) == false, "closed wrapper cannot configure")
		_check(_admission(object.call("start"), false, "invalid_state") and _admission(object.call("submit", {"kind": "list_players", "payload": {}}), false, "invalid_state"), "closed admission remains closed")
		object = null
		joined = await _management(host, descriptor)
	else:
		_retained = object
	# A failed actual join deliberately retains its reference/extension ownership.
	# Root's supervisor retains failed logs/process, never treats timeout as join.
	return _receipt(joined)

func _records(host: Node, object: Object) -> void:
	var id: String = "0123456789abcdef0123456789abcdef"
	var create: Dictionary = {"kind": "create_player", "payload": {"id": id, "name": "Bridge A", "utc": "2026-10-11T12:00:00Z"}}
	var admitted: Variant = object.call("submit", create)
	create.payload.name = "mutated caller copy"
	var made: Dictionary = await _terminal(host, object, admitted)
	_check(made.get("state") == "committed" and made.get("commit_sequence") == "2" and made.get("error_code") == "", "actual create commit")
	if not _closed(made.get("value"), ["player", "preferences"]):
		_check(false, "actual complete player/preferences pair")
		return
	_check(made.value.player.id == id and made.value.player.name == "Bridge A" and made.value.player.revision == "1" and made.value.preferences.player_id == id and made.value.preferences.revision == "1", "owned input snapshot and cross-column revision")
	var audio: Variant = made.value.preferences.audio
	_check(_closed(audio, ["enabled", "engine_gain", "airflow_gain", "show_panel_captions"]) and typeof(audio.engine_gain) == TYPE_FLOAT and _same_bits(audio.engine_gain, 1.0) and typeof(audio.airflow_gain) == TYPE_FLOAT and _same_bits(audio.airflow_gain, 1.0), "actual FLOAT defaults, not JSON integer coercion")
	var save: Dictionary = {"kind": "save_preferences", "payload": {"player_id": id, "expected_revision": "1", "utc": "2026-10-11T12:00:01Z", "seed": {"legacy_input": null, "piston_input": null, "audio": {"enabled": true, "engine_gain": -0.0, "airflow_gain": 0.5, "show_panel_captions": false}}}}
	var changed: Dictionary = await _terminal(host, object, object.call("submit", save))
	_check(changed.get("state") == "committed" and changed.get("commit_sequence") == "3" and changed.get("error_code") == "", "actual preference commit")
	if not _closed(changed.get("value"), ["player", "preferences"]):
		_check(false, "saved complete pair")
		return
	audio = changed.value.preferences.audio
	_check(typeof(audio.engine_gain) == TYPE_FLOAT and _same_bits(audio.engine_gain, -0.0) and _same_bits(audio.airflow_gain, 0.5), "actual tagged binary64 restores signed zero and fraction")
	changed.value.preferences.audio.engine_gain = 1.0
	var loaded: Dictionary = await _terminal(host, object, object.call("submit", {"kind": "load_player", "payload": {"player_id": id}}))
	_check(loaded.get("state") == "read" and loaded.get("commit_sequence") == null and loaded.get("error_code") == "", "actual readonly load")
	if _closed(loaded.get("value"), ["player", "preferences"]):
		_check(loaded.value.player.revision == "2" and loaded.value.preferences.revision == "2" and _same_bits(loaded.value.preferences.audio.engine_gain, -0.0), "returned DTO copy cannot mutate durable bits/revisions")
	else:
		_check(false, "loaded complete pair")
	var stale: Dictionary = await _terminal(host, object, object.call("submit", {"kind": "rename_player", "payload": {"player_id": id, "expected_revision": "1", "name": "Stale", "utc": "2026-10-11T12:00:02Z"}}))
	_check(stale.get("state") == "failed" and stale.get("error_code") == "revision_conflict" and stale.get("commit_sequence") == null and stale.get("value") == null, "actual failed SQL-dependent terminal is closed/null")
	var cursor: Dictionary = await _terminal(host, object, object.call("submit", {"kind": "list_practice", "payload": {"player_id": id, "before_creation_sequence": "0", "limit": 1}}))
	_check(cursor.get("state") == "read" and _closed(cursor.get("value"), ["practice", "next_before_creation_sequence"]) and cursor.value.practice == [] and cursor.value.next_before_creation_sequence == null, "actual full-U64 zero cursor read")

	await _two_result_transfer(host, object, id)
	await _numeric_preferences(host, object, id)


# Two real queued read results transfer together through the shared boundary.
# Independent complete values use the fixed pre-numeric revision2 fixture.
func _two_result_transfer(host: Node, object: Object, id: String) -> void:
	var first: Variant = object.call("submit", {"kind":"load_player", "payload":{"player_id":id}})
	var second: Variant = object.call("submit", {"kind":"list_practice", "payload":{"player_id":id, "before_creation_sequence":"0", "limit":1}})
	var admitted: bool = _admission(first,true,"") and _admission(second,true,"") and first.request_id != second.request_id
	_check(admitted, "two-result batch has distinct actually accepted request IDs")
	if not admitted:
		return
	var deadline: int = Time.get_ticks_msec() + 30000
	var ready: Variant = object.call("status")
	while Time.get_ticks_msec() < deadline:
		ready = object.call("status")
		if _status(ready) and ready.state == "ready" and ready.pending == 0 and ready.undelivered == 2:
			break
		await host.get_tree().process_frame
	var both_ready: bool = _status(ready) and ready.state == "ready" and ready.pending == 0 and ready.undelivered == 2
	_check(both_ready, "both actual FIFO terminals ready before one batch poll")
	if not both_ready:
		return
	var values: Variant = object.call("poll",2)
	_check(typeof(values) == TYPE_ARRAY and values.size() == 2, "one actual ClassDB poll transfers exactly two results")
	if typeof(values) != TYPE_ARRAY or values.size() != 2:
		return
	var pair: Dictionary = {"player":{"type":"LocalPlayer", "version":1, "id":id, "name":"Bridge A", "created_utc":"2026-10-11T12:00:00Z", "updated_utc":"2026-10-11T12:00:01Z", "revision":"2"}, "preferences":{"type":"LocalPlayerPreferences", "version":1, "player_id":id, "revision":"2", "legacy_input":null, "piston_input":null, "audio":{"enabled":true, "engine_gain":-0.0, "airflow_gain":0.5, "show_panel_captions":false}}}
	var expected: Array = [{"request_id":first.request_id, "kind":"load_player", "state":"read", "error_code":"", "commit_sequence":null, "value":pair}, {"request_id":second.request_id, "kind":"list_practice", "state":"read", "error_code":"", "commit_sequence":null, "value":{"practice":[], "next_before_creation_sequence":null}}]
	_check(_typed_equal(values,expected), "two-result FIFO complete envelopes and independent value/type/binary64 expectations")
	var drained: Variant = object.call("status")
	_check(_status(drained) and drained.pending == 0 and drained.undelivered == 0 and object.call("poll",2) == [], "whole batch ACK drains both terminals without a prefix or duplicate")
	var next: Variant = object.call("submit", {"kind":"load_player", "payload":{"player_id":id}})
	var reread: Dictionary = await _terminal(host,object,next)
	var expected_next: Dictionary = {"request_id":next.request_id, "kind":"load_player", "state":"read", "error_code":"", "commit_sequence":null, "value":pair}
	_check(_typed_equal(reread,expected_next) and _typed_equal(values,expected), "entire returned two-result caller-owned batch survives next native poll and slot reuse")

