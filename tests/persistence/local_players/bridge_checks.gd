# Compact ORIGINAL descriptor spelling: decimal INT and LE FLOAT remain explicit.
# All ordinary strings/bools/null/arrays/dictionary keys keep their exact types.
# No naked JSON number is permitted anywhere in this frozen fixture slice.
func _typed_fixture(node: Variant) -> Variant:
	if typeof(node) == TYPE_DICTIONARY:
		if node.size()==1 and node.has("$int"): return String(node["$int"]).to_int()
		if node.size()==1 and node.has("$f64le"): return String(node["$f64le"]).hex_decode().decode_double(0)
		if node.size()==1 and node.has("$name"): return StringName(node["$name"])
		var dictionary_values: Dictionary = {}
		for key: String in node: dictionary_values[key] = _typed_fixture(node[key])
		return dictionary_values
	if typeof(node) == TYPE_ARRAY:
		var array_values: Array = []
		for value: Variant in node: array_values.append(_typed_fixture(value))
		return array_values
	if typeof(node) in [TYPE_NIL,TYPE_BOOL,TYPE_STRING]: return node
	_check(false,"unexpected naked number/type in frozen fixture")
	return null

func _typed_equal(a: Variant, b: Variant) -> bool:
	if typeof(a) != typeof(b): return false
	if typeof(a) == TYPE_DICTIONARY:
		if a.size() != b.size(): return false
		for key: Variant in a:
			if typeof(key) != TYPE_STRING or not b.has(key) or not _typed_equal(a[key], b[key]): return false
		for key: Variant in b:
			if typeof(key) != TYPE_STRING: return false
		return true
	if typeof(a) == TYPE_ARRAY:
		if a.size() != b.size(): return false
		for i: int in range(a.size()):
			if not _typed_equal(a[i], b[i]): return false
		return true
	return _same_bits(a, b)

func _expected_preferences(id: String, revision: int, seed: Dictionary) -> Dictionary:
	return {"type":"LocalPlayerPreferences", "version":1, "player_id":id, "revision":str(revision), "legacy_input":seed.legacy_input, "piston_input":seed.piston_input, "audio":seed.audio}

func _reject_seed(object: Object, id: String, revision: int, seed: Variant, error: String, label: String) -> void:
	var before: Variant = object.call("status")
	_check(_status(before) and before.state=="ready" and before.pending==0 and before.undelivered==0, label+" isolated empty ready queue before rejection")
	var request: Dictionary = {"kind":"save_preferences", "payload":{"player_id":id, "expected_revision":str(revision), "utc":"2026-10-11T12:00:03Z", "seed":seed}}
	_check(_admission(object.call("submit", request), false, error), label+" exact synchronous rejection")
	_check(_same_bits(before, object.call("status")), label+" root/state/queue authority unchanged")
	_check(object.call("poll",8)==[], label+" no terminal was queued")

func _numeric_preferences(host: Node, object: Object, id: String) -> void:
