	var revision: int = 2
	var commit: int = 3
	# Exact prior accepted _records seed, not read from consumer output.
	var previous: Dictionary = {"legacy_input":null, "piston_input":null, "audio":{"enabled":true, "engine_gain":-0.0, "airflow_gain":0.5, "show_panel_captions":false}}
	_check(PackedFloat64Array([_typed_fixture({"$f64le":"0100000000000000"})]).to_byte_array().hex_encode()=="0100000000000000", "fixture smallest subnormal restored as exact eight bytes")
	for row: Dictionary in fixtures.rows:
		var input_seed: Dictionary = _typed_fixture(row.input)
		var input_before: Dictionary = input_seed.duplicate(true)
		if not row.valid:
			# ClassDB capture rejects devices[9] before the core invalid_record validator.
			_reject_seed(object,id,revision,input_seed,"payload_limit" if row.id=="CAP_complete_ninth_device" else row.error,row.id)
		else:
			var expected_seed: Dictionary = _typed_fixture(row.expected)
			var no_change: bool = _typed_equal(previous,expected_seed)
			if not no_change:
				revision += 1
				commit += 1
			var request: Dictionary = {"kind":"save_preferences", "payload":{"player_id":id, "expected_revision":str(revision if no_change else revision-1), "utc":"2026-10-11T12:00:03Z", "seed":input_seed}}
			var result: Dictionary = await _terminal(host,object,object.call("submit",request))
			_check(result.get("kind")=="save_preferences" and result.get("state")==("no_change" if no_change else "committed") and result.get("error_code")=="" and result.get("commit_sequence")==str(commit),row.id+" exact normalized equality/revision/commit accounting")
			if _closed(result.get("value"),["player","preferences"]):
				_check(_typed_equal(result.value.preferences,_expected_preferences(id,revision,expected_seed)),row.id+" complete normalized preference bundle/type/bits")
				_check(result.value.player.id==id and result.value.player.name=="Bridge A" and result.value.player.revision==str(revision),row.id+" player/preferences revision remains atomic")
				# Returned owned DTO mutation must not affect later SQLite load.
				result.value.preferences.audio.engine_gain = 0.25
			else: _check(false,row.id+" complete actual save pair")
			previous = expected_seed.duplicate(true)
		_check(_typed_equal(input_seed,input_before),row.id+" actual admission never normalizes caller-owned Variant")
		var loaded: Dictionary = await _terminal(host,object,object.call("submit",{"kind":"load_player","payload":{"player_id":id}}))
		_check(loaded.get("state")=="read" and loaded.get("commit_sequence")==null and loaded.get("error_code")=="" and _closed(loaded.get("value"),["player","preferences"]),row.id+" actual SQLite roundtrip terminal")
		if _closed(loaded.get("value"),["player","preferences"]):
			_check(_typed_equal(loaded.value.preferences,_expected_preferences(id,revision,previous)),row.id+" durable complete expected bundle after valid/rejected input")
			_check(loaded.value.player.revision==str(revision),row.id+" durable player revision")
	var capture_base: Dictionary = _typed_fixture(fixtures.rows[1].input)
	for row: Dictionary in fixtures.capture_negatives:
		var seed: Dictionary = capture_base.duplicate(true)
		match row.mutator:
			"audio_inf": seed.audio.engine_gain = INF
			"audio_negative_inf": seed.audio.engine_gain = -INF
			"seed_stringname_key":
				var value: Variant = seed.audio
				seed.erase("audio")
				seed[StringName("audio")] = value
			"axis_stringname_key":
				var axis: Dictionary = seed.legacy_input.axes[0]
				var value: Variant = axis.kind
				axis.erase("kind")
				axis[StringName("kind")] = value
			"preset_stringname_type": seed.legacy_input.type = StringName("InputPreset")
			"continuous_bool": seed.legacy_input.axes[2].value = true
			"continuous_string": seed.legacy_input.axes[2].value = "0"
			"enum_bool": seed.legacy_input.version = true
			"enum_string": seed.legacy_input.version = "1"
			"record_version": seed["version"] = 1.0 # Explicit String key: forbidden record metadata is not a seed field.
			"missing_seed_key": seed.erase("audio")
			"extra_seed_key": seed["extra"] = 0
		_reject_seed(object,id,revision,seed,row.error,row.id)
	for invalid_seed: Variant in [null,[],true,1,1.0,"seed",StringName("seed"),Vector2.ZERO]:
		_reject_seed(object,id,revision,invalid_seed,"invalid_type","capture non-Dictionary seed "+str(typeof(invalid_seed)))
	var final: Dictionary = await _terminal(host,object,object.call("submit",{"kind":"load_player","payload":{"player_id":id}}))
	_check(_closed(final.get("value"),["player","preferences"]) and _typed_equal(final.value.preferences,_expected_preferences(id,revision,previous)),"all capture negatives preserve complete durable normalized bundle")
	# Exact normalized retry after every rejection proves no hidden revision/commit increment.
	var retry: Dictionary = await _terminal(host,object,object.call("submit",{"kind":"save_preferences","payload":{"player_id":id,"expected_revision":str(revision),"utc":"2026-10-11T12:00:03Z","seed":previous.duplicate(true)}}))
	_check(retry.get("state")=="no_change" and retry.get("commit_sequence")==str(commit) and retry.get("error_code")=="" and _closed(retry.get("value"),["player","preferences"]) and _typed_equal(retry.value.preferences,_expected_preferences(id,revision,previous)),"post-rejection normalized retry preserves exact acknowledged revision/commit")

func _management(host: Node, descriptor: Dictionary) -> bool:
	# New wrapper and new monotonic native service ordinal; same isolated root.
	# Management mode itself never opens SQLite. This is not relaunch/crash proof.
	var object: Object = ClassDB.instantiate("LocalPlayersTest")
	_check(object.call("configure_test_root", descriptor) == true, "second capability uses fresh service ID")
	var started: Dictionary = await _terminal(host, object, object.call("start_management"))
	_check(started.get("kind") == "start_management" and started.get("state") == "read" and started.get("commit_sequence") == null and started.get("error_code") == "" and _closed(started.get("value"), ["management_only"]) and typeof(started.value.management_only) == TYPE_BOOL and started.value.management_only, "actual management-only closed terminal")
	var state: Variant = object.call("status")
	_check(_status(state) and state.state == "unavailable" and state.error_code == "" and state.store_version == null and state.writer_alive == true, "management lifetime has no database version")
	_check(_admission(object.call("submit", {"kind": "list_players", "payload": {}}), false, "invalid_state"), "management forbids ordinary store jobs")
	var listed: Dictionary = await _terminal(host, object, object.call("submit", {"kind": "list_recovery", "payload": {}}))
	_check(listed.get("state") == "read" and listed.get("commit_sequence") == null and listed.get("error_code") == "" and _closed(listed.get("value"), ["snapshots"]) and typeof(listed.value.snapshots) == TYPE_ARRAY and listed.value.snapshots.is_empty(), "fresh isolated recovery listing")
	if await _close(host, object):
		object = null
		return true
	_retained = object
	return false

func _receipt(joined: bool) -> Dictionary:
	return {"passed": _failures.is_empty() and joined, "checks": _checks, "failures": _failures.duplicate(), "evidence": {"joined": joined, "boundary": "same-production-LocalPlayersBoundary", "capability": "Root-bound-isolated-test", "journey": false}, "scope": "focused-ClassDB-parity-not-complete-219"}
