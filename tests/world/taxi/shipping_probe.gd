func execute(binding_path: String,output_root: String,requested_driver: String)->void:
	if _executed:
		push_error("TAXI_PACKED_PROBE_DUPLICATE_EXECUTION");get_tree().quit(1);return
	_executed=true
	var selected: Dictionary=request(OS.get_cmdline_user_args())
	if selected.is_empty() or selected.mode!="probe" or selected.binding_path!=binding_path or selected.driver!=requested_driver:
		push_error("TAXI_PACKED_PROBE_REQUEST_INVALID");get_tree().quit(1);return
	var binding: Dictionary=admit(binding_path,selected.binding_sha256,"probe")
	if binding.is_empty() or binding.output_root!=output_root:
		push_error("TAXI_PACKED_PROBE_BINDING_INVALID");get_tree().quit(1);return
	var failures: Array[String]=[]
	if not ClassDB.class_exists("FlightInteractiveSession"): failures.append("actual_native_class")
	if RenderingServer.get_current_rendering_method()!="gl_compatibility" or RenderingServer.get_current_rendering_driver_name()!=requested_driver or DisplayServer.get_name()!="Windows": failures.append("actual_renderer")
	for index in range(4): await get_tree().process_frame
	await RenderingServer.frame_post_draw
	var image: Image=get_tree().root.get_texture().get_image()
	if image==null or image.is_empty(): failures.append("actual_capture")
	var result: Dictionary={"schema":"TaxiShippingPackedPrerequisite/v1","passed":failures.is_empty(),"failures":failures,"context":binding.context,"executable_path":OS.get_executable_path(),"executable_sha256":FileAccess.get_sha256(OS.get_executable_path()),"pck_sha256":FileAccess.get_sha256(binding.pck.path),"binding_sha256":FileAccess.get_sha256(binding_path),"renderer":RenderingServer.get_current_rendering_method(),"driver":RenderingServer.get_current_rendering_driver_name(),"display_server":DisplayServer.get_name(),"capture_observed":image!=null and not image.is_empty(),"scope":"Fixed packed transport prerequisite only; no session or142-image qualification"}
	var output: String=output_root.path_join("transport-probe.json")
	if FileAccess.file_exists(output): get_tree().quit(1);return
	var file: FileAccess=FileAccess.open(output,FileAccess.WRITE)
	if file==null: get_tree().quit(1);return
	file.store_string(JSON.stringify(result,"  ",false,true));file.flush()
	var written: bool=file.get_error()==OK;file.close()
	if not written: get_tree().quit(1);return
	if failures.is_empty(): print("TAXI_SHIPPING_PACKED_PROBE_PASS")
	get_tree().quit(0 if failures.is_empty() else 1)
