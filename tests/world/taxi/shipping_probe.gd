var _executed: bool=false

static func _hex(value: Variant,length: int)->bool:
	if not value is String or value.length()!=length: return false
	for character in value:
		if not character in "0123456789abcdef": return false
	return true
static func _absolute(value: Variant)->bool:
	return value is String and not value.is_empty() and value.is_absolute_path() and not value.begins_with("res://") and not value.begins_with("user://") and not "\u0000" in value
static func _keys(value: Variant,expected: Array)->bool:
	if not value is Dictionary or value.size()!=expected.size(): return false
	for key in expected:
		if not value.has(key): return false
	return true
static func _integer(value: Variant)->int:
	if typeof(value) not in [TYPE_INT,TYPE_FLOAT]: return -1
	if typeof(value)==TYPE_FLOAT and (not is_finite(value) or value!=floor(value)): return -1
	if value<0 or value>9007199254740991: return -1
	return int(value)
static func _pin(value: Variant,absolute: bool=true)->Dictionary:
	if not _keys(value,["path","bytes","sha256"]) or not _hex(value.sha256,64) or _integer(value.bytes)<0: return {}
	if absolute:
		if not _absolute(value.path): return {}
	else:
		if not value.path is String or value.path.is_empty() or value.path.begins_with("/") or ":" in value.path or "\\" in value.path or "\u0000" in value.path: return {}
		for component in value.path.split("/",true):
			if component in ["",".",".."]: return {}
	return {"path":value.path,"bytes":_integer(value.bytes),"sha256":value.sha256}
static func _actual(row: Dictionary,resource: bool=false)->bool:
	var path: String=("res://"+row.path) if resource else row.path
	var file: FileAccess=FileAccess.open(path,FileAccess.READ)
	if file==null: return false
	var length: int=file.get_length()
	file.close()
	return length==row.bytes and FileAccess.get_sha256(path)==row.sha256
static func request(arguments: PackedStringArray)->Dictionary:
	if arguments.size()!=6 or arguments[0]!="--camera-checks": return {}
	var prefixes: Array[String]=["--taxi-observer=","--taxi-observer-binding=","--taxi-observer-binding-sha256=","--camera-request-method=","--camera-request-driver="]
	var values: Array[String]=[]
	for index in range(5):
		if not arguments[index+1].begins_with(prefixes[index]): return {}
		values.append(arguments[index+1].trim_prefix(prefixes[index]))
	if not values[0] in ["probe","capture"] or not _absolute(values[1]) or not _hex(values[2],64) or values[3]!="gl_compatibility" or not values[4] in ["opengl3","opengl3_angle"]: return {}
	return {"mode":values[0],"binding_path":values[1],"binding_sha256":values[2],"driver":values[4]}
static func binding_shape(value: Variant)->Dictionary:
	if not _keys(value,BINDING_KEYS) or value.schema!="QualifiedTaxiPackedCameraPreparation/v1" or not value.context in ["portable","replacement"]: return {}
	for name in ["source_head","native_source_head"]:
		if not _hex(value[name],40): return {}
	if not _hex(value.source_fingerprint,64) or value.source_variant!="jsbsim-1.3.1-event-aware-coupled-midpoint-local-window-v2": return {}
	if not _absolute(value.payload) or not _absolute(value.output_root) or not value.scope is String or value.scope.is_empty(): return {}
	var result: Dictionary=value.duplicate(true)
	for name in ["native_predecessor_admission","executable","pck","qualification_manifest","whole_flight_result","payload_inventory","editor_preparation","editor_visual_receipt"]:
		result[name]=_pin(value[name])
		if result[name].is_empty(): return {}
	if result.executable.path.replace("\\","/")!=value.payload.replace("\\","/").path_join("WholeFlightPreview.exe") or result.pck.path.replace("\\","/")!=value.payload.replace("\\","/").path_join("WholeFlightPreview.pck"): return {}
	if not value.expected_modules is Dictionary or value.expected_modules.size()!=7: return {}
	for name in value.expected_modules:
		var module: Variant=value.expected_modules[name]
		if not name is String or name!=name.to_lower() or name.get_file()!=name or not name.ends_with(".dll") or not _keys(module,["bytes","sha256"]) or _integer(module.bytes)<0 or not _hex(module.sha256,64): return {}
		result.expected_modules[name]={"bytes":_integer(module.bytes),"sha256":module.sha256}
	for name in ["resource_files","source_files"]:
		if not value[name] is Array or value[name].is_empty(): return {}
		var seen: Dictionary={}
		result[name]=[]
		for original in value[name]:
			var row: Dictionary=_pin(original,name=="source_files")
			if row.is_empty() or seen.has(row.path): return {}
			seen[row.path]=true
			result[name].append(row)
		if name=="resource_files":
			for path in PACKED:
				if not seen.has(path): return {}
	if not value.expected_matrix is Array or value.expected_matrix.size()!=142 or _integer(value.expected_images)!=142: return {}
	result.expected_matrix=[]
	for original in value.expected_matrix:
		if not _keys(original,["name","width","height","profile","start","page","tick_zero"]) or typeof(original.tick_zero)!=TYPE_BOOL: return {}
		var row: Dictionary=original.duplicate(true)
		row.width=_integer(original.width); row.height=_integer(original.height)
		result.expected_matrix.append(row)
	if result.expected_matrix!=EXPECTED_MATRIX: return {}
	result.expected_images=142
	return result
static func admit(path: String,digest: String,mode: String)->Dictionary:
	if not _absolute(path) or not _hex(digest,64) or not mode in ["probe","capture"] or FileAccess.get_sha256(path)!=digest: return {}
	var file: FileAccess=FileAccess.open(path,FileAccess.READ)
	if file==null: return {}
	# Fixed engineering sidecar only; no unbounded parser input.
	if file.get_length()>4194304:
		file.close(); return {}
	var text: String=file.get_as_text();file.close()
	var parsed: Variant=JSON.parse_string(text)
	var bound: Dictionary=binding_shape(parsed)
	if bound.is_empty(): return {}
	var output: String=bound.output_root.replace("\\","/").simplify_path()
	var payload: String=bound.payload.replace("\\","/").simplify_path()
	if output.to_lower()==payload.to_lower() or output.to_lower().begins_with(payload.to_lower()+"/") or not DirAccess.dir_exists_absolute(output): return {}
	for row in bound.source_files:
		if row.path.replace("\\","/").simplify_path().to_lower().begins_with(output.to_lower()+"/") or not _actual(row): return {}
	for row in bound.resource_files:
		if not _actual(row,true): return {}
	for name in ["native_predecessor_admission","executable","pck","qualification_manifest","whole_flight_result","payload_inventory","editor_preparation","editor_visual_receipt"]:
		if not _actual(bound[name]): return {}
	if OS.get_executable_path().replace("\\","/").to_lower()!=bound.executable.path.replace("\\","/").to_lower() or Identity.SOURCE_FINGERPRINT!=bound.source_fingerprint or Identity.SOURCE_VARIANT!=bound.source_variant: return {}
	var directory: DirAccess=DirAccess.open(output)
	if directory==null or not directory.get_directories().is_empty(): return {}
	var files: PackedStringArray=directory.get_files()
	if (mode=="probe" and not files.is_empty()) or (mode=="capture" and files!=PackedStringArray(["transport-probe.json"])): return {}
	if mode=="capture":
		var prior: Variant=JSON.parse_string(FileAccess.get_file_as_string(output.path_join("transport-probe.json")))
		if not _keys(prior,["schema","passed","failures","context","executable_path","executable_sha256","pck_sha256","binding_sha256","renderer","driver","display_server","capture_observed","scope"]): return {}
		if prior.schema!="TaxiShippingPackedPrerequisite/v1" or typeof(prior.passed)!=TYPE_BOOL or not prior.passed or not prior.failures is Array or not prior.failures.is_empty() or typeof(prior.capture_observed)!=TYPE_BOOL or not prior.capture_observed: return {}
		if prior.binding_sha256!=digest or prior.executable_sha256!=bound.executable.sha256 or prior.pck_sha256!=bound.pck.sha256 or prior.context!=bound.context or prior.executable_path.replace("\\","/").to_lower()!=bound.executable.path.replace("\\","/").to_lower(): return {}
		if prior.renderer!="gl_compatibility" or not prior.driver in ["opengl3","opengl3_angle"] or prior.display_server!="Windows" or not prior.scope is String or prior.scope.is_empty(): return {}
	return bound
