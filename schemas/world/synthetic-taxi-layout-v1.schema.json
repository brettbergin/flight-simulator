                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                  "minLength": 1,
                  "maxLength": 48
                },
                "label": {
                  "type": "string",
                  "pattern": "^[ -~]+$",
                  "minLength": 1,
                  "maxLength": 80
                },
                "point_eus_m": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number",
                    "minimum": -2000,
                    "maximum": 2000
                  }
                }
              }
            }
          }
        }
