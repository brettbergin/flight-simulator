              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                "minLength": 1,
                "maxLength": 48
              },
              "label": {
                "type": "string",
                "pattern": "^[ -~]+$",
                "minLength": 1,
                "maxLength": 80
              },
              "center_xz_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "minimum": -2000,
                  "maximum": 2000
                }
              },
              "half_extent_xz_m": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 2000
