                    [
                      0,
                      1
                    ],
                    [
                      0,
                      -1
                    ]
                  ]
                },
                "panels": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 2,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role",
                      "label",
                      "direction_xz"
