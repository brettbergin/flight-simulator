                      "label": {
                        "type": "string",
                        "pattern": "^[ -~]+$",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "direction_xz": {
                        "anyOf": [
                          {
                            "enum": [
                              [
                                1,
                                0
                              ],
                              [
                                -1,
                                0
                              ],
                              [
                                0,
                                1
                              ],
                              [
                                0,
                                -1
                              ]
                            ]
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    }
                  }
                }
              }
            }
