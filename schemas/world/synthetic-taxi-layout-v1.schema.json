            "enum": [
              "to-parking",
              "to-stop-reference"
            ]
          },
          "runway": {
            "enum": [
              36,
              18,
              null
            ]
          },
          "link": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 48
          },
          "parking": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "minLength": 1,
            "maxLength": 48
