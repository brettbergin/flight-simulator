{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flight-simulator.invalid/contracts/world/resident-runtime/v1/component.schema.json",
  "$comment": "Shape only. Combined entries1..256, cross-array path uniqueness, actual ordered reviewed roster, normalized file bytes/size and digest recipe, transitive dependency closure and external manifest pin remain mandatory independent gates. No digest of unwritten source or executable glob is authorized.",
  "type": "object",
  "properties": {
    "schema": {"const": "ResidentWorldComponent/v1"},
    "sources": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
    "controls": {"type": "array", "maxItems": 256, "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}}
  },
  "required": ["schema", "sources", "controls"], "additionalProperties": false,
  "anyOf": [{"type": "object", "properties": {"sources": {"type": "array", "minItems": 1}}}, {"type": "object", "properties": {"controls": {"type": "array", "minItems": 1}}}],
  "$defs": {
    "safe_path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?:(?!\\.{1,2}(?:/|$))[^/\\\\:\\u0000-\\u001f]+/)*(?!\\.{1,2}$)[^/\\\\:\\u0000-\\u001f]+$(?![\\s\\S])"},
    "sha256": {"$ref": "start-recipe.schema.json#/$defs/sha256"},
    "binding": {
      "type": "object",
      "properties": {"path": {"$ref": "#/$defs/safe_path"}, "sha256": {"$ref": "#/$defs/sha256"}},
      "required": ["path", "sha256"], "additionalProperties": false
    }
  }
}
