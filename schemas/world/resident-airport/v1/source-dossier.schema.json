{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flight-simulator.invalid/contracts/world/resident-airport/v1/source-dossier.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "enum": [
        "AirportSourceDossier/v1"
      ]
    },
    "airport_icao": {
      "enum": [
        "KAWO"
      ]
    },
    "purpose": {
      "enum": [
        "source-record",
        "synthetic-fixture"
      ]
    },
    "as_of_utc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "https://flight-simulator.invalid/contracts/world/resident-airport/v1/common.schema.json#/$defs/source"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "https://flight-simulator.invalid/contracts/world/resident-airport/v1/common.schema.json#/$defs/conflict"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      },
      "minItems": 0,
      "maxItems": 64
    }
  },
  "required": [
    "schema",
    "airport_icao",
    "purpose",
    "as_of_utc",
    "sources",
    "conflicts",
    "notes"
  ],
  "additionalProperties": false
}
